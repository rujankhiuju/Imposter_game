{
  "expo": {
    "name": "Imposter",
    "slug": "imposter",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.imposterapp.game",
      "supportsTablet": false
    },
    "android": {
      "package": "com.imposterapp.game",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0F"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-av",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0A0A0F"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "edda1613-115f-4197-a822-e61ce6e3213e"
      },
      "router": {}
    },
    "owner": "rujan12"
  }
}
